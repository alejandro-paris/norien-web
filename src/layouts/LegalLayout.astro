---
// Plantilla de las páginas legales (escritas en Markdown): misma cabecera y pie que el
// resto de la web, con tipografía sencilla de texto corrido.
import BaseLayout from './BaseLayout.astro';

interface Props {
  frontmatter: { title: string; description: string; updated: string };
}

const { title, description, updated } = Astro.props.frontmatter;
---

<BaseLayout title={title} description={description}>
  <article
    class="legal mx-auto max-w-3xl px-6 pt-32 pb-24 md:pt-40 md:pb-32
      [&_a]:underline [&_a]:decoration-gold [&_a]:underline-offset-4 [&_a:hover]:text-gold-deep
      [&_h2]:mt-12 [&_h2]:mb-3 [&_h2]:scroll-mt-28 [&_h2]:font-display [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:tracking-tight md:[&_h2]:text-2xl
      [&_li]:mt-1.5 [&_p]:mt-4 [&_strong]:font-semibold [&_strong]:text-ink
      [&_ul]:mt-4 [&_ul]:list-disc [&_ul]:pl-5 [&_li]:marker:text-gold
      text-base leading-relaxed text-ink-soft md:text-[17px]"
  >
    <h1 class="text-3xl font-bold tracking-tight md:text-4xl">{title}</h1>
    <slot />
    <p class="!mt-14 border-t border-ink/10 pt-6 text-sm">Última actualización: {updated}.</p>
  </article>
</BaseLayout>
