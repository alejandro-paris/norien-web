---
// Etiqueta pequeña de sección: distintivo dorado + nombre de la sección.
// `node` la convierte en un nodo de la línea guía.
interface Props {
  label: string;
  tone?: 'light' | 'dark' | 'gold';
  node?: boolean;
  class?: string;
}

const { label, tone = 'light', node = false, class: className } = Astro.props;
---

<p
  class:list={[
    'mb-5 inline-flex items-center gap-2.5 text-sm font-medium md:mb-6',
    tone === 'dark' ? 'text-paper/75' : tone === 'gold' ? 'text-ink/80' : 'text-ink-soft',
    className,
  ]}
  {...(node ? { 'data-guide-node': '' } : {})}
>
  <span class:list={['size-2.5 rounded-[3px]', tone === 'gold' ? 'bg-ink' : 'bg-gold']} aria-hidden="true"></span>
  {label}
</p>
