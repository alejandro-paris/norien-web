---
import SectionLabel from '../SectionLabel.astro';

// Párrafo que se "ilumina" palabra a palabra con el scroll.
const segments = [
  { text: 'Contestamos antes de que se vayan a otro. Escribimos cuando toca volver. Cobramos sin que tengas que pedirlo.' },
  { text: 'Y cuidamos tu imagen, también fuera de la pantalla.', gold: true },
];
---

<section data-statement class="relative">
  <div class="guide-container py-28 md:py-40">
    <SectionLabel num="03" label="En resumen" node />
    <p data-statement-text class="max-w-4xl font-display text-2xl font-medium leading-[1.2] tracking-tight sm:text-3xl md:text-4xl xl:text-[2.75rem]">
      {
        segments.map((seg, i) => (
          <>
            <span class:list={[seg.gold && 'text-gold-deep']}>
              {seg.text.split(' ').map((w, j, arr) => (
                <>
                  <span data-reveal-word>{w}</span>
                  {j < arr.length - 1 && ' '}
                </>
              ))}
            </span>
            {i < segments.length - 1 && ' '}
          </>
        ))
      }
    </p>
  </div>
</section>
