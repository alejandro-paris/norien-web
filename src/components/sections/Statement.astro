---
// Párrafo que se "ilumina" palabra a palabra con el scroll.
const segments = [
  { text: 'Automatizamos WhatsApp con IA y añadimos estrategia comercial —guiones y campañas segmentadas— para' },
  { text: 'captar, reactivar y cobrar', gold: true },
  { text: 'sin fricción.' },
];
---

<section data-statement class="relative">
  <div class="guide-container py-28 md:py-40">
    <p data-statement-text class="max-w-5xl font-display text-3xl font-medium leading-[1.15] tracking-tight sm:text-4xl md:text-6xl">
      {
        segments.map((seg, i) => (
          <>
            <span class:list={[seg.gold && 'text-gold-deep']}>
              {seg.text.split(' ').map((w, j, arr) => (
                <>
                  <span data-reveal-word>{w}</span>
                  {j < arr.length - 1 && ' '}
                </>
              ))}
            </span>
            {i < segments.length - 1 && ' '}
          </>
        ))
      }
    </p>
  </div>
</section>
