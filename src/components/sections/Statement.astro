---
// Párrafo que se "ilumina" palabra a palabra con el scroll.
const segments = [
  { text: 'Atendemos a tus clientes al instante, los acompañamos para que vuelvan y' },
  { text: 'agilizamos tu día a día.', gold: true },
  { text: 'Además, cuidamos la imagen de tu empresa,' },
  { text: 'desde el escaparate hasta las redes.', gold: true },
];
---

<section data-statement class="relative">
  <div class="guide-container pt-8 pb-28 md:pt-14 md:pb-40">
    <p data-statement-text class="max-w-4xl font-display text-2xl font-medium leading-[1.2] tracking-tight sm:text-3xl md:text-4xl xl:text-[2.75rem]">
      {
        segments.map((seg, i) => (
          <>
            <span class:list={[seg.gold && 'text-gold-deep']}>
              {seg.text.split(' ').map((w, j, arr) => (
                <>
                  <span data-reveal-word>{w}</span>
                  {j < arr.length - 1 && ' '}
                </>
              ))}
            </span>
            {i < segments.length - 1 && ' '}
          </>
        ))
      }
    </p>
  </div>
</section>
