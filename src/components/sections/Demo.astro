---
// Vídeo demo, justo después del hero. Con animaciones, la sección se queda fija un momento
// mientras el vídeo crece un poco, para no pasarla de largo. La línea guía baja por su lateral.
import { SITE } from '../../site';
import Compass from '../Compass.astro';

const video = SITE.demoVideo;
const ratio = video?.ratio ?? 16 / 9;
---

<section id="demo" data-demo data-dark class="relative bg-ink text-paper motion:h-[170vh]">
  <div class="flex flex-col justify-center py-16 motion:sticky motion:top-0 motion:min-h-svh md:py-24">
    <div class="guide-container w-full">
      <h2 class="mb-8 text-3xl font-bold tracking-tight text-paper md:mb-10 md:text-4xl xl:text-[2.75rem]">
        Te lo enseñamos en <span class="text-gold">dos minutos.</span>
      </h2>

      <div
        data-demo-frame
        class="demo-frame relative mx-auto w-full overflow-hidden rounded-2xl bg-[#0b1140] ring-1 ring-paper/10 md:rounded-3xl"
        style={`--ratio:${ratio}`}
      >
        {
          video ? (
            <>
              <video
                class="absolute inset-0 h-full w-full object-cover"
                poster={video.poster}
                controls
                playsinline
                preload="metadata"
                data-demo-video
              >
                {/* El navegador usa la primera fuente cuyo `media` encaja: 720p en pantallas pequeñas. */}
                {video.srcSmall && <source src={video.srcSmall} type="video/mp4" media="(max-width: 1023px)" />}
                <source src={video.src} type="video/mp4" />
                Tu navegador no puede reproducir este vídeo.
              </video>
              {/* Botón de play grande. Oculto sin JS (el vídeo conserva sus controles normales). */}
              <button
                type="button"
                data-demo-play
                hidden
                class="group absolute inset-0 z-10 flex cursor-pointer flex-col items-center justify-center gap-3 bg-ink/35 transition-colors hover:bg-ink/20 md:gap-4"
                aria-label="Reproducir el vídeo"
              >
                <span class="grid size-16 place-items-center rounded-full bg-gold text-ink shadow-[0_0_0_10px_rgba(197,160,89,0.25),0_20px_50px_-10px_rgba(0,0,0,0.6)] transition-transform duration-300 group-hover:scale-110 md:size-24">
                  <svg viewBox="0 0 24 24" class="ml-1 size-7 md:size-10" fill="currentColor" aria-hidden="true"><path d="M7 4.5v15l13-7.5z" /></svg>
                </span>
                <span class="rounded-full bg-ink/60 px-3 py-1 text-xs font-medium text-paper backdrop-blur md:text-sm">Ver vídeo · 2 min</span>
              </button>
            </>
          ) : (
            <div class="absolute inset-0 grid place-items-center bg-[radial-gradient(circle_at_50%_40%,#1c2464,#050a30_70%)]">
              <Compass class="absolute w-[38%] opacity-[0.07]" ring="#f7f5f0" needle="#c5a059" />
              <p class="relative text-sm text-paper/60">Vídeo demo · próximamente</p>
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .demo-frame {
    aspect-ratio: var(--ratio);
  }

  /* Fijado: el vídeo no puede ser más alto que lo que queda de pantalla. */
  :global(.motion) .demo-frame {
    max-width: calc((100svh - 15rem) * var(--ratio));
  }
</style>
