---
// Sección de servicios: un teléfono 3D (CSS) que cuenta, con el scroll,
// una conversación real de principio a fin. Cada paso = un servicio.
import Compass from '../Compass.astro';

const steps = [
  {
    title: 'Atención 24/7 que convierte',
    text: 'Respuesta inmediata en WhatsApp y cualificación automática. Menos leads perdidos, más reservas y citas.',
  },
  {
    title: 'Sistema de reservas y citas',
    text: 'Gestión automática del calendario: confirmaciones, recordatorios y reprogramaciones sin intervención manual. Más asistencia, menos bajas.',
  },
  {
    title: 'Mensajería masiva con estrategia',
    text: 'Envío de mensajes a gran escala con oferta, copy y segmentación para llenar huecos y reactivar clientes.',
  },
  {
    title: 'Cobro y seguimiento automático',
    text: 'Recordatorios a impagos y pago directo con Stripe desde el chat. Menos fricción, más cobros a tiempo.',
  },
];

type Msg = { step: number; from: 'me' | 'them'; text: string; time: string; pay?: boolean };

// Conversación de ejemplo, vista desde el móvil del cliente.
const messages: Msg[] = [
  { step: 1, from: 'me', text: 'Hola, ¿tenéis hueco para una clase de prueba?', time: '23:47' },
  { step: 1, from: 'them', text: '¡Hola, Laura! 👋 Claro que sí. ¿Te viene mejor mañana o más adelante?', time: '23:47' },
  { step: 2, from: 'me', text: 'Mañana por la mañana', time: '23:48' },
  { step: 2, from: 'them', text: 'Tengo libre a las 10:30 o a las 12:00. ¿Cuál te reservo?', time: '23:48' },
  { step: 2, from: 'me', text: '10:30 👍', time: '23:48' },
  { step: 2, from: 'them', text: '¡Hecho! Te espero mañana a las 10:30. Te mandaré un recordatorio el día antes.', time: '23:48' },
  { step: 3, from: 'them', text: 'Laura, ¡te echamos de menos! Esta semana quedan huecos el martes y el jueves. ¿Te guardo uno?', time: '10:02' },
  { step: 3, from: 'me', text: '¡Sí! El jueves 🙌', time: '10:05' },
  { step: 4, from: 'them', text: 'Genial. Para activar tu bono, puedes pagar aquí:', time: '10:05', pay: true },
];

const frameLayers = Array.from({ length: 9 }, (_, i) => i - 4);
---

<section id="servicios" data-story class="relative scroll-mt-0 motion:h-[600vh]">
  <div class="relative py-24 motion:sticky motion:top-0 motion:flex motion:h-svh motion:items-center motion:overflow-hidden motion:pt-16 motion:pb-0 md:motion:pt-0">
    <div class="mx-auto grid w-full max-w-7xl items-center gap-10 px-6 md:grid-cols-2 md:gap-8">
      <!-- Texto de los pasos -->
      <div class="relative z-20 order-2 md:order-1">
        <p class="mb-3 text-xs font-medium uppercase tracking-[0.2em] text-ink-soft">Nuestros servicios</p>
        <h2 class="mb-8 text-3xl font-bold tracking-tight motion:max-md:sr-only md:mb-12 md:text-5xl">
          Un sistema que trabaja <span class="text-gold-deep">mientras tú atiendes.</span>
        </h2>

        <div class="mb-8 hidden gap-2 motion:flex" aria-hidden="true">
          {steps.map(() => (
            <span class="h-1 flex-1 overflow-hidden rounded-full bg-ink/10">
              <span data-progress class="block h-full origin-left scale-x-0 bg-ink"></span>
            </span>
          ))}
        </div>

        <ol class="grid gap-8 motion:gap-0 motion:[grid-template-areas:'stack'] motion:min-h-44">
          {steps.map((step, i) => (
            <li data-step={i + 1} class="motion:[grid-area:stack]">
              <p class="mb-2 font-display text-sm font-bold text-gold-deep">0{i + 1}</p>
              <h3 class="mb-3 text-2xl font-semibold md:text-3xl">{step.title}</h3>
              <p class="max-w-md text-base leading-relaxed text-ink-soft md:text-lg">{step.text}</p>
            </li>
          ))}
        </ol>
      </div>

      <!-- Teléfono 3D -->
      <div class="relative order-1 flex justify-center md:order-2">
        <div data-stage class="phone-stage relative">
          <div data-phone class="phone">
            {frameLayers.map((z) => <div class="phone-layer" style={`--z:${z * 1.6}px`} />)}

            <!-- Trasera -->
            <div class="phone-face phone-back">
              <div class="absolute left-5 top-5 grid size-24 grid-cols-2 gap-1.5 rounded-[28px] bg-white/5 p-3 ring-1 ring-white/10">
                <span class="rounded-full bg-[#02051a] ring-2 ring-white/10"></span>
                <span class="rounded-full bg-[#02051a] ring-2 ring-white/10"></span>
                <span class="rounded-full bg-[#02051a] ring-2 ring-white/10"></span>
                <span class="m-auto size-3 rounded-full bg-paper/60"></span>
              </div>
              <Compass class="absolute left-1/2 top-1/2 w-24 -translate-x-1/2 -translate-y-1/2" ring="#c5a059" needle="#f7f5f0" />
            </div>

            <!-- Pantalla -->
            <div class="phone-face phone-front">
              <div class="flex h-full flex-col overflow-hidden rounded-[40px] bg-[#ece7dc]">
                <div class="flex items-center justify-between px-7 pt-3 text-[11px] font-semibold text-ink">
                  <span>23:47</span>
                  <span class="h-5 w-20 rounded-full bg-[#050a30]"></span>
                  <span>100%</span>
                </div>
                <div class="flex items-center gap-3 border-b border-ink/5 bg-paper px-4 py-3">
                  <span class="grid size-9 place-items-center rounded-full bg-gold/25 font-display text-sm font-bold text-ink">PA</span>
                  <div class="leading-tight">
                    <p class="text-sm font-semibold text-ink">Pilates Alba</p>
                    <p class="text-[11px] text-ink-soft">Asistente · responde al instante</p>
                  </div>
                </div>

                <div class="flex flex-1 flex-col justify-end overflow-hidden px-3 pb-3 text-[13px] leading-snug">
                  {messages.map((m) => (
                    <div data-msg={m.step} class="shrink-0 overflow-hidden">
                    <div class:list={['flex pt-2', m.from === 'me' ? 'justify-end' : 'justify-start']}>
                      <div
                        class:list={[
                          'max-w-[82%] rounded-2xl px-3 py-2 shadow-sm',
                          m.from === 'me' ? 'rounded-br-md bg-[#dcd0b4] text-ink' : 'rounded-bl-md bg-white text-ink',
                        ]}
                      >
                        <p>{m.text}</p>
                        {m.pay && (
                          <div class="mt-2 overflow-hidden rounded-xl border border-ink/10">
                            <div class="bg-paper px-3 py-2">
                              <p class="text-[11px] text-ink-soft">Bono 5 clases</p>
                              <p class="font-display text-base font-bold">45,00 €</p>
                            </div>
                            <p class="bg-ink py-1.5 text-center text-xs font-semibold text-paper">Pagar ahora</p>
                          </div>
                        )}
                        <p class="mt-0.5 text-right text-[10px] text-ink-soft/70">{m.time}</p>
                      </div>
                    </div>
                    </div>
                  ))}
                </div>

                <div class="flex items-center gap-2 bg-paper px-3 pt-2 pb-5">
                  <span class="h-8 flex-1 rounded-full bg-white px-3 text-[12px] leading-8 text-ink-soft/60">Mensaje</span>
                  <span class="grid size-8 place-items-center rounded-full bg-ink text-paper">
                    <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true"><path d="M3 20l18-8L3 4v6l12 2-12 2z" /></svg>
                  </span>
                </div>
              </div>
            </div>
          </div>

          <!-- Tarjetas flotantes, una por paso -->
          <div data-card="1" class="float-card left-[-18%] top-[10%] md:left-auto md:right-[calc(100%-3.5rem)]">
            <span class="float-icon"><svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/></svg></span>
            <div>
              <p class="float-title">Respuesta inmediata</p>
              <p class="float-sub">23:47 · fuera de horario</p>
            </div>
          </div>
          <div data-card="2" class="float-card left-[-22%] top-[40%] md:left-auto md:right-[calc(100%-3rem)] md:top-[30%]">
            <span class="float-icon"><svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18M9 16l2 2 4-4"/></svg></span>
            <div>
              <p class="float-title">Cita confirmada</p>
              <p class="float-sub">Jueves 10:30 · Recordatorio programado</p>
            </div>
          </div>
          <div data-card="3" class="float-card right-[-20%] top-[26%] md:right-auto md:left-[calc(100%-3.5rem)]">
            <span class="float-icon"><svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 11 18-5v12L3 14v-3z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/></svg></span>
            <div>
              <p class="float-title">Campaña de reactivación</p>
              <p class="float-sub">Segmento: clientes inactivos</p>
            </div>
          </div>
          <div data-card="4" class="float-card right-[-16%] bottom-[10%] md:right-auto md:left-[calc(100%-3rem)]">
            <span class="float-icon !bg-ink !text-gold"><svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></span>
            <div>
              <p class="float-title">Pago recibido</p>
              <p class="float-sub">45,00 € · Stripe</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .phone-stage {
    --w: 290px;
    --h: 600px;
    width: var(--w);
    height: var(--h);
    perspective: 1600px;
    transform-style: preserve-3d;
  }

  @media (max-width: 767px) {
    .phone-stage {
      --w: 190px;
      --h: 394px;
    }
  }

  .phone {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
  }

  /* Capas apiladas en Z: dan grosor real al canto del teléfono. */
  .phone-layer {
    position: absolute;
    inset: 0;
    border-radius: 48px;
    background: linear-gradient(135deg, #2a3163, #0b1036 60%, #1d2352);
    transform: translateZ(var(--z));
  }

  .phone-face {
    position: absolute;
    inset: 0;
    border-radius: 48px;
    backface-visibility: hidden;
  }

  .phone-front {
    padding: 9px;
    background: #050a30;
    transform: translateZ(7px);
    box-shadow: 0 40px 80px -30px rgb(5 10 48 / 0.45);
  }

  .phone-back {
    background: radial-gradient(circle at 30% 20%, #1f2760, #050a30 70%);
    transform: rotateY(180deg) translateZ(7px);
  }

  .float-card {
    position: absolute;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: max-content;
    max-width: 16rem;
    padding: 0.75rem 1rem 0.75rem 0.75rem;
    border-radius: 1.25rem;
    background: rgb(255 255 255 / 0.85);
    backdrop-filter: blur(12px);
    box-shadow:
      0 1px 0 rgb(255 255 255) inset,
      0 24px 48px -20px rgb(5 10 48 / 0.35);
    outline: 1px solid rgb(5 10 48 / 0.06);
  }

  .float-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.8rem;
    background: rgb(197 160 89 / 0.2);
    color: var(--color-ink);
  }

  .float-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-ink);
  }

  .float-sub {
    font-size: 0.75rem;
    color: var(--color-ink-soft);
  }

  @media (max-width: 767px) {
    .float-card {
      max-width: 12rem;
      padding: 0.5rem 0.75rem 0.5rem 0.5rem;
      gap: 0.5rem;
    }
    .float-icon {
      width: 2rem;
      height: 2rem;
    }
    .float-title {
      font-size: 0.8rem;
    }
    .float-sub {
      font-size: 0.65rem;
    }
  }
</style>
