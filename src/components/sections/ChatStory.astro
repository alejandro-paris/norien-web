---
// Servicios contados como una conversación real. El chat se queda fijo mientras
// pasan los cuatro servicios; al llegar la línea guía a cada uno, el chat avanza.
const steps = [
  {
    title: 'Atención 24/7 que convierte',
    text: 'Respuesta inmediata en WhatsApp y cualificación automática. Menos leads perdidos, más reservas y citas.',
  },
  {
    title: 'Sistema de reservas y citas',
    text: 'Gestión automática del calendario: confirmaciones, recordatorios y reprogramaciones sin intervención manual. Más asistencia, menos bajas.',
  },
  {
    title: 'Mensajería masiva con estrategia',
    text: 'Envío de mensajes a gran escala con oferta, copy y segmentación para llenar huecos y reactivar clientes.',
  },
  {
    title: 'Cobro y seguimiento automático',
    text: 'Recordatorios a impagos y pago directo con Stripe desde el chat. Menos fricción, más cobros a tiempo.',
  },
];

type Msg = { step: number; from: 'me' | 'them'; text: string; time: string; pay?: boolean; day?: string };

// Conversación de ejemplo, vista desde el móvil del cliente.
const messages: Msg[] = [
  { step: 1, from: 'me', text: 'Hola, ¿tenéis hueco para una clase de prueba?', time: '23:47' },
  { step: 1, from: 'them', text: '¡Hola, Laura! 👋 Claro que sí. ¿Te viene mejor mañana o más adelante?', time: '23:47' },
  { step: 2, from: 'me', text: 'Mañana por la mañana', time: '23:48' },
  { step: 2, from: 'them', text: 'Tengo libre a las 10:30 o a las 12:00. ¿Cuál te reservo?', time: '23:48' },
  { step: 2, from: 'me', text: '10:30 👍', time: '23:48' },
  { step: 2, from: 'them', text: '¡Hecho! Te espero mañana a las 10:30. Te mandaré un recordatorio el día antes.', time: '23:48' },
  { step: 3, from: 'them', day: 'Dos meses después', text: 'Laura, ¡te echamos de menos! Esta semana quedan huecos el martes y el jueves. ¿Te guardo uno?', time: '10:02' },
  { step: 3, from: 'me', text: '¡Sí! El jueves 🙌', time: '10:05' },
  { step: 4, from: 'them', text: 'Genial. Para activar tu bono, puedes pagar aquí:', time: '10:05', pay: true },
];

const icon = (d: string) =>
  `<svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;

// Etiquetas flotantes que refuerzan lo que pasa en cada paso.
const pills = [
  { title: 'Respuesta inmediata', sub: '23:47 · fuera de horario', icon: icon('<path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/>'), pos: 'left-3 top-[18%] md:-left-8 md:top-[22%] xl:-left-12' },
  { title: 'Cita confirmada', sub: 'Jueves 10:30 · recordatorio programado', icon: icon('<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18M9 16l2 2 4-4"/>'), pos: 'right-3 top-[30%] md:-right-4 md:top-[34%] xl:-right-14' },
  { title: 'Campaña de reactivación', sub: 'Segmento: clientes inactivos', icon: icon('<path d="m3 11 18-5v12L3 14v-3z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/>'), pos: 'left-3 top-[24%] md:-left-8 md:top-[26%] xl:-left-14' },
  { title: 'Pago recibido', sub: '45,00 € · Stripe', icon: icon('<path d="M20 6 9 17l-5-5"/>'), pos: 'right-3 bottom-[24%] md:-right-4 md:bottom-[26%] xl:-right-12', dark: true },
];
---

<section id="servicios" data-story class="relative">
  <div class="guide-container pt-16 pb-24 md:pt-24">
    <p data-guide-node class="mb-3 text-xs font-medium uppercase tracking-[0.2em] text-ink-soft">Nuestros servicios</p>
    <h2 class="max-w-3xl text-3xl font-bold tracking-tight md:text-5xl">
      Un sistema que trabaja <span class="text-gold-deep">mientras tú atiendes.</span>
    </h2>

    <div class="mt-12 grid gap-10 md:mt-4 md:grid-cols-[1fr_1.2fr] md:gap-16">
      <!-- Pasos (uno por servicio) -->
      <ol class="order-2 motion:pb-[30svh] md:order-1">
        {steps.map((step, i) => (
          <li data-step={i + 1} class="py-8 transition-opacity duration-500 motion:min-h-[60svh] motion:pt-[6svh] motion:pb-0 md:motion:min-h-[62svh]">
            <p data-guide-node class="mb-2 font-display text-sm font-bold text-gold-deep">0{i + 1}</p>
            <h3 class="mb-3 text-2xl font-semibold md:text-3xl">{step.title}</h3>
            <p class="max-w-md text-base leading-relaxed text-ink-soft md:text-lg">{step.text}</p>
          </li>
        ))}
      </ol>

      <!-- Chat -->
      <!-- En móvil el envoltorio desaparece (contents) para que el chat se fije a lo largo de toda la sección. -->
      <div class="max-md:contents md:order-2">
        <div class="z-10 bg-paper pb-4 max-md:order-1 motion:sticky motion:top-[68px] md:bg-transparent md:pb-0 md:motion:top-[14svh]">
          <div class="relative mx-auto max-w-xl">
            <div class="chat-panel flex flex-col overflow-hidden rounded-[2rem] bg-white shadow-[0_50px_100px_-40px_rgba(5,10,48,0.35)] ring-1 ring-ink/5">
              <div class="flex items-center gap-3 border-b border-ink/5 px-5 py-4">
                <span class="grid size-10 place-items-center rounded-full bg-gold/25 font-display text-sm font-bold text-ink">PA</span>
                <div class="leading-tight">
                  <p class="font-semibold text-ink">Pilates Alba</p>
                  <p class="text-xs text-ink-soft"><span class="mr-1 inline-block size-1.5 rounded-full bg-emerald-500 align-middle"></span>en línea · asistente automático</p>
                </div>
              </div>

              <div data-chat class="flex flex-1 flex-col justify-end overflow-hidden bg-[#f1ede4] px-4 pb-4 text-[14px] leading-snug md:px-6 md:text-[15px]">
                {messages.map((m) => (
                  <div data-msg={m.step} data-from={m.from} class="shrink-0 overflow-hidden">
                    {m.day && (
                      <p class="pt-4 text-center">
                        <span class="rounded-full bg-white/70 px-3 py-1 text-[11px] uppercase tracking-wider text-ink-soft">{m.day}</span>
                      </p>
                    )}
                    <div class:list={['flex pt-2.5', m.from === 'me' ? 'justify-end' : 'justify-start']}>
                      <div
                        class:list={[
                          'max-w-[80%] rounded-2xl px-4 py-2.5 shadow-[0_1px_1px_rgba(5,10,48,0.06)]',
                          m.from === 'me' ? 'rounded-br-md bg-[#dcd0b4] text-ink' : 'rounded-bl-md bg-white text-ink',
                        ]}
                      >
                        <p>{m.text}</p>
                        {m.pay && (
                          <div class="mt-2 overflow-hidden rounded-xl border border-ink/10">
                            <div class="bg-paper px-3 py-2">
                              <p class="text-xs text-ink-soft">Bono 5 clases</p>
                              <p class="font-display text-lg font-bold">45,00 €</p>
                            </div>
                            <p class="bg-ink py-2 text-center text-sm font-semibold text-paper">Pagar ahora</p>
                          </div>
                        )}
                        <p class="mt-0.5 text-right text-[10px] text-ink-soft/70">{m.time}</p>
                      </div>
                    </div>
                  </div>
                ))}
                <div data-typing class="hidden shrink-0 overflow-hidden" aria-hidden="true">
                  <div class="flex pt-2.5">
                    <div class="flex gap-1 rounded-2xl rounded-bl-md bg-white px-4 py-3.5">
                      <span class="typing-dot"></span><span class="typing-dot"></span><span class="typing-dot"></span>
                    </div>
                  </div>
                </div>
              </div>

              <div class="flex items-center gap-2 border-t border-ink/5 px-4 py-3">
                <span class="h-10 flex-1 rounded-full bg-[#f1ede4] px-4 text-sm leading-10 text-ink-soft/60">Mensaje</span>
                <span class="grid size-10 place-items-center rounded-full bg-ink text-paper">
                  <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true"><path d="M3 20l18-8L3 4v6l12 2-12 2z" /></svg>
                </span>
              </div>
            </div>

            {pills.map((p, i) => (
              <div data-pill={i + 1} class:list={['pill absolute z-10', p.pos]}>
                <span class:list={['pill-icon', p.dark && '!bg-ink !text-gold']} set:html={p.icon} />
                <span>
                  <span class="block font-display text-sm font-semibold text-ink">{p.title}</span>
                  <span class="block text-xs text-ink-soft">{p.sub}</span>
                </span>
              </div>
            ))}

            <div class="mt-5 hidden gap-2 motion:flex" aria-hidden="true">
              {steps.map(() => (
                <span class="h-1 flex-1 overflow-hidden rounded-full bg-ink/10">
                  <span data-progress class="block h-full origin-left scale-x-0 bg-ink"></span>
                </span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .chat-panel {
    height: 34rem;
  }

  :global(.motion) .chat-panel {
    height: min(66svh, 40rem);
  }

  @media (max-width: 767px) {
    :global(.motion) .chat-panel {
      height: 46svh;
    }
  }

  :global(html:not(.motion)) .pill {
    display: none;
  }

  .pill {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: max-content;
    max-width: 18rem;
    padding: 0.5rem 1.25rem 0.5rem 0.5rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.6);
    backdrop-filter: blur(16px) saturate(1.4);
    -webkit-backdrop-filter: blur(16px) saturate(1.4);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.8) inset,
      0 20px 40px -18px rgb(5 10 48 / 0.35);
    outline: 1px solid rgb(5 10 48 / 0.06);
  }

  .pill-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    background: rgb(197 160 89 / 0.25);
    color: var(--color-ink);
  }

  @media (max-width: 767px) {
    .pill {
      max-width: 15rem;
      padding: 0.35rem 0.9rem 0.35rem 0.35rem;
      gap: 0.5rem;
    }
    .pill-icon {
      width: 1.75rem;
      height: 1.75rem;
    }
  }

  .typing-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--color-ink-soft);
    opacity: 0.5;
    animation: typing 1s infinite ease-in-out;
  }

  .typing-dot:nth-child(2) {
    animation-delay: 0.15s;
  }

  .typing-dot:nth-child(3) {
    animation-delay: 0.3s;
  }

  @keyframes typing {
    0%,
    60%,
    100% {
      transform: translateY(0);
      opacity: 0.4;
    }
    30% {
      transform: translateY(-4px);
      opacity: 1;
    }
  }
</style>
