---
// Servicios contados como una conversación real. El chat se queda fijo mientras
// pasan los cuatro servicios; al llegar la línea guía a cada uno, el chat avanza.
const steps = [
  {
    title: 'Contesta al momento, a cualquier hora',
    text: 'Aunque sean las doce de la noche o estés con otro cliente. Pregunta lo necesario para saber qué busca cada persona y nadie se queda esperando.',
  },
  {
    title: 'Da cita y la apunta en tu agenda',
    text: 'Ofrece los huecos que tienes libres, confirma la cita y manda un recordatorio el día antes. Si alguien no puede venir, la cambia sin que tengas que llamar.',
  },
  {
    title: 'Avisa a tus clientes cuando te interesa',
    text: '¿Te quedan huecos esta semana o hay clientes que hace meses que no vienen? Preparamos contigo el mensaje y a quién mandarlo, y sale para todos de una vez.',
  },
  {
    title: 'Cobra sin perseguir a nadie',
    text: 'Manda el enlace de pago por el mismo chat y recuerda los pagos pendientes con educación. El dinero te llega por Stripe.',
  },
];

type Msg = { step: number; from: 'me' | 'them'; text: string; time: string; pay?: boolean; day?: string };

// Conversación de ejemplo, vista desde el móvil del cliente.
const messages: Msg[] = [
  { step: 1, from: 'me', text: 'Hola, ¿tenéis hueco para una clase de prueba?', time: '23:47' },
  { step: 1, from: 'them', text: '¡Hola, Laura! 👋 Claro que sí. ¿Te viene mejor mañana o más adelante?', time: '23:47' },
  { step: 2, from: 'me', text: 'Mañana por la mañana', time: '23:48' },
  { step: 2, from: 'them', text: 'Tengo libre a las 10:30 o a las 12:00. ¿Cuál te reservo?', time: '23:48' },
  { step: 2, from: 'me', text: '10:30 👍', time: '23:48' },
  { step: 2, from: 'them', text: '¡Hecho! Te espero mañana a las 10:30. Te mandaré un recordatorio el día antes.', time: '23:48' },
  { step: 3, from: 'them', day: 'Dos meses después', text: 'Laura, ¡te echamos de menos! Esta semana quedan huecos el martes y el jueves. ¿Te guardo uno?', time: '10:02' },
  { step: 3, from: 'me', text: '¡Sí! El jueves 🙌', time: '10:05' },
  { step: 4, from: 'them', text: 'Genial. Para activar tu bono, puedes pagar aquí:', time: '10:05', pay: true },
];

const icon = (d: string) =>
  `<svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;

// Etiquetas flotantes que refuerzan lo que pasa en cada paso.
const pills = [
  { title: 'Contestado al momento', sub: '23:47 · ya habías cerrado', icon: icon('<path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/>'), pos: 'left-3 top-[18%] md:-left-8 md:top-[22%] xl:-left-12' },
  { title: 'Cita apuntada', sub: 'Jueves 10:30 · le avisamos el día antes', icon: icon('<rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18M9 16l2 2 4-4"/>'), pos: 'right-3 top-[30%] md:-right-4 md:top-[34%] xl:-right-14' },
  { title: 'Mensaje enviado', sub: 'A quienes llevan 2 meses sin venir', icon: icon('<path d="m3 11 18-5v12L3 14v-3z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/>'), pos: 'left-3 top-[24%] md:-left-8 md:top-[26%] xl:-left-14' },
  { title: 'Pago recibido', sub: '45,00 € · Stripe', icon: icon('<path d="M20 6 9 17l-5-5"/>'), pos: 'right-3 bottom-[24%] md:-right-4 md:bottom-[26%] xl:-right-12', dark: true },
];
---

<section id="servicios" data-story class="relative motion:h-[520vh]">
  <div data-story-pin class="motion:sticky motion:top-0 motion:flex motion:h-svh motion:flex-col motion:justify-center motion:overflow-hidden">
  <div class="guide-container w-full pt-16 pb-24 md:pt-24 motion:pt-[72px] motion:pb-4 md:motion:pt-16">
    <p data-guide-node class="mb-3 text-sm font-medium text-ink-soft">Qué hacemos</p>
    <h2 class="max-w-3xl text-3xl font-bold tracking-tight motion:max-md:sr-only md:text-5xl">
      Tú atiendes a quien tienes delante. <span class="text-gold-deep">Del WhatsApp nos ocupamos nosotros.</span>
    </h2>

    <div class="mt-12 grid gap-10 motion:mt-2 motion:gap-6 md:grid-cols-[1fr_1.2fr] md:items-center md:gap-16 md:motion:mt-8 md:motion:gap-16">
      <!-- Pasos (uno por servicio). Con animaciones se apilan y se muestra solo el activo. -->
      <ol class="order-2 grid gap-8 motion:gap-0 motion:[grid-template-areas:'stack'] motion:max-md:hidden md:order-1">
        {steps.map((step, i) => (
          <li data-step={i + 1} class="motion:[grid-area:stack]">
            <p class="mb-2 font-display text-sm font-bold text-gold-deep">0{i + 1}</p>
            <h3 class="mb-3 text-2xl font-semibold md:text-3xl">{step.title}</h3>
            <p class="max-w-md text-base leading-relaxed text-ink-soft md:text-lg">{step.text}</p>
          </li>
        ))}
      </ol>

      <!-- Chat -->
      <div class="order-1 md:order-2">
        <div>
          <div class="relative mx-auto max-w-xl">
            <div class="chat-panel flex flex-col overflow-hidden rounded-[2rem] bg-white shadow-[0_50px_100px_-40px_rgba(5,10,48,0.35)] ring-1 ring-ink/5">
              <div class="flex items-center gap-3 border-b border-ink/5 px-5 py-4">
                <span class="grid size-10 place-items-center rounded-full bg-gold/25 font-display text-sm font-bold text-ink">PA</span>
                <div class="leading-tight">
                  <p class="font-semibold text-ink">Pilates Alba</p>
                  <p class="text-xs text-ink-soft"><span class="mr-1 inline-block size-1.5 rounded-full bg-emerald-500 align-middle"></span>en línea · respuesta automática</p>
                </div>
              </div>

              <div data-chat class="flex flex-1 flex-col justify-end overflow-hidden bg-[#f1ede4] px-4 pb-4 text-[14px] leading-snug md:px-6 md:text-[15px]">
                {messages.map((m) => (
                  <div data-msg={m.step} data-from={m.from} class="shrink-0 overflow-hidden">
                    {m.day && (
                      <p class="pt-4 text-center">
                        <span class="rounded-full bg-white/70 px-3 py-1 text-xs text-ink-soft">{m.day}</span>
                      </p>
                    )}
                    <div class:list={['flex pt-2.5', m.from === 'me' ? 'justify-end' : 'justify-start']}>
                      <div
                        class:list={[
                          'max-w-[80%] rounded-2xl px-4 py-2.5 shadow-[0_1px_1px_rgba(5,10,48,0.06)]',
                          m.from === 'me' ? 'rounded-br-md bg-[#dcd0b4] text-ink' : 'rounded-bl-md bg-white text-ink',
                        ]}
                      >
                        <p>{m.text}</p>
                        {m.pay && (
                          <div class="mt-2 overflow-hidden rounded-xl border border-ink/10">
                            <div class="bg-paper px-3 py-2">
                              <p class="text-xs text-ink-soft">Bono 5 clases</p>
                              <p class="font-display text-lg font-bold">45,00 €</p>
                            </div>
                            <p class="bg-ink py-2 text-center text-sm font-semibold text-paper">Pagar ahora</p>
                          </div>
                        )}
                        <p class="mt-0.5 text-right text-[10px] text-ink-soft/70">{m.time}</p>
                      </div>
                    </div>
                  </div>
                ))}
                <div data-typing class="hidden shrink-0 overflow-hidden" aria-hidden="true">
                  <div class="flex pt-2.5">
                    <div class="flex gap-1 rounded-2xl rounded-bl-md bg-white px-4 py-3.5">
                      <span class="typing-dot"></span><span class="typing-dot"></span><span class="typing-dot"></span>
                    </div>
                  </div>
                </div>
              </div>

              <div class="flex items-center gap-2 border-t border-ink/5 px-4 py-3">
                <span class="h-10 flex-1 rounded-full bg-[#f1ede4] px-4 text-sm leading-10 text-ink-soft/60">Mensaje</span>
                <span class="grid size-10 place-items-center rounded-full bg-ink text-paper">
                  <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true"><path d="M3 20l18-8L3 4v6l12 2-12 2z" /></svg>
                </span>
              </div>
            </div>

            <!-- Móvil: presentación de cada servicio sobre el chat desenfocado -->
            <div data-step-overlay aria-hidden="true" class="step-overlay absolute inset-0 z-20 hidden rounded-[2rem] motion:max-md:grid">
              {steps.map((step, i) => (
                <div data-overlay-step={i + 1} class="overlay-step [grid-area:1/1] self-center px-7">
                  <p class="mb-3 font-display text-sm font-bold text-gold-deep">0{i + 1}</p>
                  <p class="mb-3 font-display text-3xl font-semibold leading-tight text-ink">{step.title}</p>
                  <p class="text-base leading-relaxed text-ink-soft">{step.text}</p>
                </div>
              ))}
            </div>

            {pills.map((p, i) => (
              <div data-pill={i + 1} class:list={['pill absolute z-10', p.pos]}>
                <span class:list={['pill-icon', p.dark && '!bg-ink !text-gold']} set:html={p.icon} />
                <span>
                  <span class="block font-display text-sm font-semibold text-ink">{p.title}</span>
                  <span class="block text-xs text-ink-soft">{p.sub}</span>
                </span>
              </div>
            ))}

            <div class="mt-5 hidden gap-2 motion:flex" aria-hidden="true">
              {steps.map(() => (
                <span class="h-1 flex-1 overflow-hidden rounded-full bg-ink/10">
                  <span data-progress class="block h-full origin-left scale-x-0 bg-ink"></span>
                </span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  </div>
</section>

<style>
  .chat-panel {
    height: 34rem;
  }

  :global(.motion) .chat-panel {
    height: min(60svh, 38rem);
  }

  @media (max-width: 767px) {
    :global(.motion) .chat-panel {
      height: calc(100svh - 160px);
    }
  }

  .step-overlay {
    pointer-events: none;
    opacity: 0;
    background: rgb(247 245 240 / 0.55);
    backdrop-filter: blur(14px) saturate(1.2);
    transition: opacity 0.5s ease;
  }

  .step-overlay[data-open] {
    opacity: 1;
  }

  .overlay-step {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 0.45s ease,
      transform 0.45s ease;
  }

  .step-overlay[data-open] .overlay-step[data-active] {
    opacity: 1;
    transform: none;
  }

  :global(html:not(.motion)) .pill {
    display: none;
  }

  .pill {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: max-content;
    max-width: 18rem;
    padding: 0.5rem 1.25rem 0.5rem 0.5rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.6);
    backdrop-filter: blur(16px) saturate(1.4);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.8) inset,
      0 20px 40px -18px rgb(5 10 48 / 0.35);
    outline: 1px solid rgb(5 10 48 / 0.06);
  }

  .pill-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    background: rgb(197 160 89 / 0.25);
    color: var(--color-ink);
  }

  @media (max-width: 767px) {
    .pill {
      max-width: 15rem;
      padding: 0.35rem 0.9rem 0.35rem 0.35rem;
      gap: 0.5rem;
    }
    .pill-icon {
      width: 1.75rem;
      height: 1.75rem;
    }
  }

  .typing-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--color-ink-soft);
    opacity: 0.5;
    animation: typing 1s infinite ease-in-out;
  }

  .typing-dot:nth-child(2) {
    animation-delay: 0.15s;
  }

  .typing-dot:nth-child(3) {
    animation-delay: 0.3s;
  }

  @keyframes typing {
    0%,
    60%,
    100% {
      transform: translateY(0);
      opacity: 0.4;
    }
    30% {
      transform: translateY(-4px);
      opacity: 1;
    }
  }
</style>
