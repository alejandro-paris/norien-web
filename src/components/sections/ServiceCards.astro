---
// Servicios como tarjetas que se apilan al hacer scroll. Cada tarjeta tiene su
// propia mini demo, que se monta con el scroll (no con el tiempo): si bajas rápido
// llegas al resultado final, si subes retrocede.
const services = [
  {
    title: 'Contesta al momento, a cualquier hora',
    text: 'Por WhatsApp, Instagram o Telegram, aunque sean las doce de la noche. Si no puedes coger una llamada, le escribimos al momento. Y si quieres, una voz coge el teléfono por ti.',
  },
  {
    title: 'Tu marca, igual de bien en la calle que en el móvil',
    text: 'Logo, rótulo, escaparate, tarjetas, uniformes, redes y web. Una sola imagen, de la puerta de tu local a tu perfil de Instagram.',
  },
  {
    title: 'Una promoción distinta para cada cliente',
    text: 'Ofertas, recordatorios y avisos según lo que compra cada uno. A quien no viene desde marzo no le llega lo mismo que a quien vino ayer.',
  },
  {
    title: 'Cobra sin perseguir a nadie',
    text: 'Envía el enlace de pago por el chat y recuerda pagos pendientes y renovaciones.',
  },
];

const icon = (d: string) =>
  `<svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
const check = icon('<path d="M20 6 9 17l-5-5"/>');

// Marca ficticia para el mockup de imagen (tarjeta 02): "alba", estudio de pilates.
const brand = { name: 'alba', terracotta: '#b8563b', cream: '#f2e8da', olive: '#5f6847' };
const sun = (color: string, cls = '') =>
  `<svg viewBox="0 0 24 16" class="${cls}" fill="none" stroke="${color}" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M4 13a8 8 0 0 1 16 0"/><path d="M1.5 15h21"/></svg>`;
const igTiles = ['t', 'c', 'o', 'c', 't', 'c', 'o', 'c', 't'];

const people = ['MR', 'JL', 'AP', 'SG', 'CN', 'LB'];
---

<section id="servicios" data-services class="relative">
  <div class="guide-container pt-16 pb-24 md:pt-24 md:pb-32">
    <p data-guide-node class="mb-3 text-sm font-medium text-ink-soft">Qué hacemos</p>
    <h2 class="max-w-3xl text-3xl font-bold tracking-tight md:text-5xl">
      Esto es lo que hacemos. <span class="text-gold-deep">Y lo que dejas de hacer tú.</span>
    </h2>

    <div data-cards class="mt-12 grid gap-6 motion:gap-[18svh] md:mt-16">
      {
        services.map((s, i) => (
          <>
            {/* Marca fija en el flujo (no se pega): sirve de disparador y de nodo de la línea guía. */}
            <span data-card-marker data-guide-node aria-hidden="true" class="pointer-events-none -mb-6 block h-0 motion:-mb-[18svh]" />
            <article
              data-service-card={i + 1}
              class="service-card origin-top rounded-[2rem] bg-white p-6 shadow-[0_40px_80px_-40px_rgba(5,10,48,0.3)] ring-1 ring-ink/5 motion:sticky md:p-10"
              style={`--i:${i}`}
            >
              <div class="grid gap-6 md:grid-cols-[1fr_1.1fr] md:items-center md:gap-12">
                <div>
                  <p class="mb-2 font-display text-sm font-bold text-gold-deep">0{i + 1}</p>
                  <h3 class="mb-3 text-2xl font-semibold leading-tight md:text-4xl">{s.title}</h3>
                  <p class="text-base leading-relaxed text-ink-soft md:text-lg">{s.text}</p>
                </div>

                <div data-card-demo class="demo-area relative overflow-hidden rounded-2xl bg-[#f1ede4] p-4 text-[14px] leading-snug md:p-6 md:text-[15px]">
                  {i === 0 && (
                    <div class="flex h-full flex-col justify-center gap-3">
                      <div data-d="in" class="bubble bubble-in self-start">
                        <p>Hola, ¿tenéis hueco para mañana?</p>
                        <p class="bubble-time">23:47</p>
                      </div>
                      {/* "Escribiendo…" y la respuesta ocupan el mismo hueco para que nada salte. */}
                      <div class="grid justify-items-end [&>*]:[grid-area:1/1]">
                        <div data-d="typing" class="bubble bubble-out hidden gap-1 self-start py-3.5 motion:flex" aria-hidden="true">
                          <span class="typing-dot" /><span class="typing-dot" /><span class="typing-dot" />
                        </div>
                        <div data-d="out" class="bubble bubble-out self-end">
                          <p>¡Hola! Sí, a las 10:30 o a las 12:00. ¿Cuál te va mejor?</p>
                          <p class="bubble-time">23:47</p>
                        </div>
                      </div>
                      <div data-d="tag" class="tag self-start">
                        <span class="tag-icon" set:html={icon('<path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z"/>')} />
                        Contestado al momento, aunque ya habías cerrado
                      </div>
                    </div>
                  )}

                  {i === 1 && (
                    <div class="flex h-full flex-col justify-center gap-4" style={`--t:${brand.terracotta};--c:${brand.cream};--o:${brand.olive}`}>
                      <div class="grid grid-cols-[1fr_0.95fr_1fr] items-center gap-2.5 md:gap-4">
                        {/* Fachada con rótulo */}
                        <div data-d="piece" class="overflow-hidden rounded-lg bg-[var(--c)] shadow-sm ring-1 ring-ink/5">
                          <div class="flex items-center justify-center gap-1 bg-[var(--t)] py-1.5 md:py-2.5">
                            <span set:html={sun(brand.cream, 'w-3 md:w-5')} />
                            <span class="font-display text-[9px] font-bold tracking-tight text-[var(--c)] md:text-sm">{brand.name}</span>
                          </div>
                          <div class="grid grid-cols-[1.6fr_1fr] gap-1 p-1.5 pb-0 md:gap-1.5 md:p-2.5 md:pb-0">
                            <div class="relative aspect-[3/4] rounded-t-sm bg-gradient-to-br from-[#3b3f36] to-[#22251f]">
                              <span class="absolute inset-x-0 top-1/3 flex justify-center opacity-80" set:html={sun(brand.cream, 'w-3 md:w-5')} />
                            </div>
                            <div class="relative aspect-[1/2] self-end rounded-t-sm bg-[var(--o)]">
                              <span class="absolute top-1/2 right-0.5 size-0.5 rounded-full bg-[var(--c)] md:size-1" />
                            </div>
                          </div>
                          <div class="h-1 bg-[#d9cdb9]" />
                        </div>

                        {/* Tarjeta de visita */}
                        <div data-d="piece" class="relative">
                          <div class="absolute inset-0 translate-x-1 translate-y-1.5 rotate-3 rounded-md bg-[var(--t)]" />
                          <div class="relative flex aspect-[1.6] -rotate-3 flex-col justify-between rounded-md bg-[var(--c)] p-1.5 shadow-sm ring-1 ring-ink/5 md:p-3">
                            <span class="flex items-center gap-1">
                              <span set:html={sun(brand.terracotta, 'w-2.5 md:w-4')} />
                              <span class="font-display text-[8px] font-bold text-[var(--t)] md:text-xs">{brand.name}</span>
                            </span>
                            <span class="text-[5px] leading-tight text-[var(--o)] md:text-[8px]">pilates · reformer<br />Calle del Sol, 12</span>
                          </div>
                        </div>

                        {/* Perfil de Instagram */}
                        <div data-d="piece" class="overflow-hidden rounded-lg bg-white p-1.5 shadow-sm ring-1 ring-ink/5 md:p-2.5">
                          <div class="mb-1.5 flex items-center gap-1 md:mb-2 md:gap-1.5">
                            <span class="grid size-3.5 place-items-center rounded-full bg-[var(--t)] md:size-6" set:html={sun(brand.cream, 'w-2 md:w-3.5')} />
                            <span class="text-[6px] font-semibold text-ink md:text-[10px]">{brand.name}pilates</span>
                          </div>
                          <div class="grid grid-cols-3 gap-px md:gap-0.5">
                            {igTiles.map((t, k) => (
                              <span
                                class="grid aspect-square place-items-center"
                                style={`background:${t === 't' ? brand.terracotta : t === 'o' ? brand.olive : brand.cream}`}
                                set:html={k % 4 === 0 ? sun(t === 'c' ? brand.terracotta : brand.cream, 'w-2 md:w-3.5') : ''}
                              />
                            ))}
                          </div>
                        </div>
                      </div>
                      <div data-d="tag" class="tag self-start">
                        <span class="tag-icon" set:html={icon('<circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/><circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/><circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/><circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.93 0 1.65-.75 1.65-1.69 0-.44-.18-.84-.44-1.13-.29-.29-.44-.65-.44-1.13a1.64 1.64 0 0 1 1.67-1.67h2c3.05 0 5.56-2.5 5.56-5.55C21.97 6.01 17.46 2 12 2z"/>')} />
                        Misma marca en la calle, en la web y en Instagram
                      </div>
                    </div>
                  )}

                  {i === 2 && (
                    <div class="flex h-full flex-col justify-center gap-4">
                      <div data-d="out" class="bubble bubble-out self-end">
                        <p>¡Hola! Esta semana nos quedan huecos el martes y el jueves. ¿Te guardo uno?</p>
                        <p class="bubble-time">10:02</p>
                      </div>
                      <div class="flex items-center justify-end gap-1.5">
                        {people.map((p) => (
                          <span class="relative grid size-9 place-items-center rounded-full bg-white text-[11px] font-semibold text-ink-soft shadow-sm">
                            {p}
                            <span data-d="sent" class="absolute -right-0.5 -bottom-0.5 grid size-4 place-items-center rounded-full bg-ink text-gold">
                              <svg viewBox="0 0 24 24" class="size-2.5" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
                            </span>
                          </span>
                        ))}
                      </div>
                      <div data-d="in" class="bubble bubble-in self-start">
                        <p>¡Sí! El jueves 🙌</p>
                        <p class="bubble-time">10:05</p>
                      </div>
                      <div data-d="tag" class="tag self-start">
                        <span class="tag-icon" set:html={icon('<path d="m3 11 18-5v12L3 14v-3z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/>')} />
                        Enviado solo a quienes compraron bono el mes pasado
                      </div>
                    </div>
                  )}

                  {i === 3 && (
                    <div class="flex h-full flex-col justify-center gap-3">
                      <div data-d="out" class="bubble bubble-out self-end">
                        <p>Para activar tu bono, puedes pagar aquí:</p>
                        <div class="mt-2 overflow-hidden rounded-xl border border-ink/10 bg-paper">
                          <div class="px-3 py-2">
                            <p class="text-xs text-ink-soft">Bono 5 clases</p>
                            <p class="font-display text-lg font-bold">45,00 €</p>
                          </div>
                          <div class="relative h-9">
                            <p data-d="pay" class="absolute inset-0 hidden place-items-center bg-ink text-sm font-semibold text-paper motion:grid">Pagar</p>
                            <p data-d="paid" class="absolute inset-0 grid place-items-center bg-gold text-sm font-semibold text-ink">Pagado ✓</p>
                          </div>
                        </div>
                        <p class="bubble-time">10:05</p>
                      </div>
                      <div data-d="tag" class="tag self-start">
                        <span class="tag-icon !bg-ink !text-gold" set:html={check} />
                        Pago recibido · 45,00 € · Stripe
                      </div>
                    </div>
                  )}
                </div>
              </div>
            </article>
          </>
        ))
      }
      <!-- Espacio para que la última tarjeta se quede un momento antes de seguir -->
      <div class="hidden h-[20svh] motion:block" aria-hidden="true"></div>
    </div>
  </div>
</section>

<style>
  /* Cada tarjeta se pega un poco más abajo que la anterior: así se ve el borde de la baraja. */
  .service-card {
    top: calc(84px + var(--i) * 14px);
  }

  @media (min-width: 768px) {
    .service-card {
      top: calc(12svh + var(--i) * 18px);
    }
  }

  .demo-area {
    min-height: 15rem;
  }

  @media (min-width: 768px) {
    .demo-area {
      min-height: 21rem;
    }
  }

  .bubble {
    max-width: 85%;
    border-radius: 1rem;
    padding: 0.6rem 0.9rem;
    color: var(--color-ink);
    box-shadow: 0 1px 1px rgb(5 10 48 / 0.06);
  }

  .bubble-in {
    background: white;
    border-bottom-left-radius: 0.35rem;
  }

  .bubble-out {
    background: #dcd0b4;
    border-bottom-right-radius: 0.35rem;
  }

  .bubble-time {
    margin-top: 0.15rem;
    text-align: right;
    font-size: 10px;
    color: rgb(61 66 96 / 0.7);
  }

  .tag {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 1rem 0.4rem 0.4rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.7);
    backdrop-filter: blur(12px);
    box-shadow: 0 16px 32px -16px rgb(5 10 48 / 0.35);
    outline: 1px solid rgb(5 10 48 / 0.06);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-ink);
  }

  .tag-icon {
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    flex-shrink: 0;
    border-radius: 999px;
    background: rgb(197 160 89 / 0.3);
    color: var(--color-ink);
  }

  .typing-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--color-ink-soft);
    opacity: 0.5;
    animation: typing 1s infinite ease-in-out;
  }

  .typing-dot:nth-child(2) {
    animation-delay: 0.15s;
  }

  .typing-dot:nth-child(3) {
    animation-delay: 0.3s;
  }

  @keyframes typing {
    0%,
    60%,
    100% {
      transform: translateY(0);
      opacity: 0.4;
    }
    30% {
      transform: translateY(-4px);
      opacity: 1;
    }
  }
</style>
