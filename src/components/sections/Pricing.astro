---
// Precios de tres servicios sobre fondo azul. La línea guía termina aquí, en "Precios".
import { siInstagram, siWhatsapp } from 'simple-icons';
import SectionLabel from '../SectionLabel.astro';

const line = (d: string) =>
  `<svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
const brand = (path: string) =>
  `<svg viewBox="0 0 24 24" class="size-5" fill="currentColor" aria-hidden="true"><path d="${path}"/></svg>`;

const plans = [
  {
    title: 'Llamadas perdidas',
    text: 'Si no puedes coger el teléfono, le escribimos al momento por WhatsApp para que no se vaya a otro sitio.',
    price: 20,
    featured: true,
    icons: [{ svg: line('<path d="M22 2 16 8M16 2l6 6"/><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/>'), label: 'Teléfono' }],
  },
  {
    title: 'Atención al cliente',
    text: 'Resuelve dudas, da cita y confirma pedidos en WhatsApp, Instagram y tu web. Con tu tono, también cuando ya has cerrado.',
    price: 120,
    icons: [
      { svg: brand(siInstagram.path), label: 'Instagram' },
      { svg: brand(siWhatsapp.path), label: 'WhatsApp' },
      { svg: line('<circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>'), label: 'Web' },
    ],
  },
  {
    title: 'Cobros por enlace',
    text: 'Te dejamos instalada la pasarela para cobrar por enlace desde el chat o desde tu web.',
    price: 50,
    icons: [{ svg: line('<rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/>'), label: 'Pago con tarjeta' }],
  },
];
---

<section id="precios" data-guide-end data-dark class="relative z-30 bg-ink text-paper">
  <!-- Tramo final de la línea guía: baja desde el borde de la sección hasta "Precios". -->
  <span data-guide-final aria-hidden="true" class="guide-final absolute left-1/2 top-0 hidden -translate-x-1/2 motion:block"></span>

  <div class="page-container pt-28 pb-24 md:pt-36 md:pb-32">
    <div class="mx-auto mb-14 max-w-2xl text-center md:mb-20">
      <span data-guide-final-node aria-hidden="true" class="guide-node-dot mx-auto mb-4 hidden motion:block"></span>
      <SectionLabel num="05" label="Precios" tone="dark" />
      <h2 data-reveal class="text-3xl font-bold tracking-tight text-paper md:text-4xl xl:text-[2.75rem]">
        Algunos de nuestros precios. <span class="text-gold">Sin preguntas.</span>
      </h2>
    </div>

    <ul class="grid gap-5 md:grid-cols-3 md:gap-6">
      {
        plans.map((p) => (
          <li
            data-reveal
            class:list={[
              'flex flex-col rounded-[1.75rem] p-8 md:p-9',
              p.featured ? 'bg-paper/[0.07] ring-2 ring-gold' : 'bg-paper/[0.04] ring-1 ring-paper/10',
            ]}
          >
            <div class="mb-8 flex gap-2">
              {p.icons.map((ic) => (
                <span
                  class:list={['grid size-10 place-items-center rounded-full', p.featured ? 'bg-gold text-ink' : 'bg-paper/10 text-gold']}
                  title={ic.label}
                  set:html={ic.svg}
                />
              ))}
            </div>
            <h3 class="text-2xl font-semibold leading-tight text-paper">{p.title}</h3>
            <p class="mt-3 flex-1 leading-relaxed text-paper/70">{p.text}</p>
            <p class="mt-8 border-t border-paper/10 pt-6">
              <span class="block text-sm text-paper/60">Desde</span>
              <span class="font-display text-5xl font-bold tracking-tight text-gold">{p.price} €</span>
            </p>
          </li>
        ))
      }
    </ul>
    <p data-reveal class="mx-auto mt-10 max-w-xl text-center text-sm text-paper/60">
      Son ejemplos para que te hagas una idea. El precio final depende de lo que montemos contigo.
    </p>
  </div>
</section>
