---
// Franja de plataformas bajo el hero. Logos monocromos de simple-icons (SVG oficiales
// de cada marca), renderizados en el build: no añade JavaScript a la página.
import {
  siWhatsapp,
  siInstagram,
  siMessenger,
  siMeta,
  siTelegram,
  siGooglecalendar,
  siGmail,
  siGoogle,
  siStripe,
  siPaypal,
  siRedsys,
} from 'simple-icons';
import SectionLabel from '../SectionLabel.astro';

const brands = [
  { icon: siWhatsapp, label: 'WhatsApp' },
  { icon: siInstagram, label: 'Instagram' },
  { icon: siMessenger, label: 'Messenger' },
  { icon: siMeta, label: 'Meta' },
  { icon: siTelegram, label: 'Telegram' },
  { icon: siGooglecalendar, label: 'Google Calendar' },
  { icon: siGmail, label: 'Gmail' },
  { icon: siGoogle, label: 'Google' },
  { icon: siStripe, label: 'Stripe' },
  { icon: siPaypal, label: 'PayPal' },
  { icon: siRedsys, label: 'Redsys' },
];
---

<section aria-labelledby="plataformas" class="relative">
  <div class="guide-container pt-20 pb-8 md:pt-28 md:pb-6">
    <SectionLabel num="02" label="Dónde trabajamos" node />
    <h2 id="plataformas" data-reveal class="max-w-3xl text-3xl font-bold tracking-tight md:text-4xl xl:text-[2.75rem]">
      Nada nuevo que instalar. <span class="text-gold-deep">Nada nuevo que aprender.</span>
    </h2>
    <p data-reveal class="mt-4 max-w-2xl text-base text-ink-soft md:text-lg">
      Trabajamos dentro de las apps que ya usáis tú y tus clientes.
    </p>
  </div>
  <!-- En móvil, una fila con scroll horizontal; en escritorio, varias filas. -->
  <div data-reveal class="logo-row guide-container overflow-x-auto pb-4 md:overflow-visible">
    <ul class="flex w-max gap-x-8 gap-y-5 pr-6 md:w-auto md:max-w-4xl md:flex-wrap md:pr-0">
      {
        brands.map((b) => (
          <li class="flex shrink-0 items-center gap-2 text-ink/80">
            <svg viewBox="0 0 24 24" class="size-5" fill="currentColor" aria-hidden="true" focusable="false">
              <path d={b.icon.path} />
            </svg>
            <span class="text-sm font-medium whitespace-nowrap">{b.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .logo-row {
    scroll-behavior: smooth;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .logo-row::-webkit-scrollbar {
    display: none;
  }

  /* Difumina el borde derecho en móvil para indicar que hay más logos. */
  @media (max-width: 767px) {
    .logo-row {
      mask-image: linear-gradient(to right, black 85%, transparent);
    }
  }
</style>
