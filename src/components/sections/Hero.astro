---
import SplitWords from '../SplitWords.astro';
---

<section data-hero class="relative flex min-h-svh flex-col justify-center pt-28 pb-16">
  <!-- Sin margen reservado para la línea en móvil: aquí la línea aún no baja por el lateral. -->
  <div class="guide-container w-full max-md:!pl-6">
    <p data-intro class="mb-6 max-w-xl text-base text-ink-soft md:text-lg">
      Para negocios que viven de atender a sus clientes.
    </p>
    <h1 class="max-w-4xl text-[2.6rem] font-bold leading-[1.02] tracking-tight sm:text-5xl md:text-6xl xl:text-[4.25rem]">
      <SplitWords text="Tú atiendes a quien tienes delante." />{' '}
      <span class="text-gold-deep"><SplitWords text="Del resto nos ocupamos nosotros." /></span>
    </h1>
    <div data-intro class="mt-10 flex flex-wrap items-center gap-3">
      <a
        href="#contacto"
        class="group inline-flex items-center gap-3 rounded-full bg-ink px-7 py-3.5 text-base font-medium text-paper transition-colors hover:bg-gold hover:text-ink"
      >
        Pide tu auditoría gratis
        <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
      </a>
      <a
        href="#demo"
        class="inline-flex items-center rounded-full px-7 py-3.5 text-base font-medium text-ink ring-1 ring-ink/15 transition-colors hover:ring-ink/40"
      >
        Ver la demo
      </a>
    </div>
    <p data-intro class="mt-5 text-sm text-ink-soft">20 minutos. Te decimos qué podemos quitarte de encima. Sin compromiso.</p>

    <!-- Punto de salida de la línea guía: baja junto al vídeo y acompaña hasta los precios -->
    <div data-intro class="mt-16 hidden items-center gap-3 motion:flex" aria-hidden="true">
      <span data-guide-start class="block size-3 rounded-full bg-gold ring-4 ring-gold/25"></span>
      <span class="text-sm text-ink-soft">Mira cómo funciona</span>
    </div>
  </div>
</section>
