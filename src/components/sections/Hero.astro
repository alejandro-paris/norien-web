---
import SplitWords from '../SplitWords.astro';
import Compass from '../Compass.astro';
---

<section data-hero class="relative motion:h-[230vh]">
  <div class="relative flex min-h-svh flex-col items-center overflow-hidden px-6 pt-32 pb-10 motion:sticky motion:top-0 motion:h-svh md:pt-40">
    <!-- Objeto 3D (Three.js). El SVG se ve sin WebGL o mientras carga. -->
    <div data-hero-object class="pointer-events-none absolute inset-0">
      <Compass class="compass-fallback absolute bottom-[4%] left-1/2 w-[min(70vw,46svh)] -translate-x-1/2 text-ink transition-opacity duration-700" />
      <canvas data-compass class="absolute inset-0 h-full w-full opacity-0 transition-opacity duration-700" aria-hidden="true"></canvas>
    </div>

    <div data-hero-copy class="relative z-10 mx-auto max-w-5xl text-center">
      <p data-intro class="mb-6 inline-flex items-center gap-2 rounded-full border border-ink/10 bg-paper/70 px-4 py-1.5 text-xs font-medium uppercase tracking-[0.2em] text-ink-soft backdrop-blur">
        <span class="size-1.5 rounded-full bg-gold"></span>
        Para PYMES de citas, reservas y membresías
      </p>
      <h1 class="text-[2.6rem] font-bold leading-[0.98] tracking-tight sm:text-6xl md:text-7xl xl:text-8xl">
        <SplitWords text="Convierte conversaciones en" />{' '}
        <span class="text-gold-deep"><SplitWords text="reservas, citas y pagos." /></span>
      </h1>
      <div data-intro class="mt-10 flex flex-col items-center gap-4">
        <a
          href="#contacto"
          class="group inline-flex items-center gap-3 rounded-full bg-ink px-8 py-4 text-base font-medium text-paper transition-colors hover:bg-gold hover:text-ink"
        >
          Quiero ahorrar tiempo
          <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
        </a>
        <p class="text-xs uppercase tracking-[0.2em] text-ink-soft">Sin compromisos · Auditoría inicial gratuita</p>
      </div>
    </div>

    <p data-scroll-hint aria-hidden="true" class="absolute bottom-6 left-1/2 z-10 hidden -translate-x-1/2 text-[11px] uppercase tracking-[0.3em] text-ink-soft motion:block">
      Desliza
    </p>
  </div>
</section>
