---
// Página legal provisional: sin indexar hasta tener el texto definitivo.
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<BaseLayout title={title} noindex>
  <section class="mx-auto max-w-3xl px-6 pt-36 pb-28 md:pt-44">
    <h1 class="text-4xl font-bold tracking-tight md:text-5xl">{title}</h1>
    <p class="mt-6 text-lg text-ink-soft">Estamos preparando este texto. Si necesitas algo mientras tanto, escríbenos.</p>
    <a href="/" class="mt-10 inline-block underline underline-offset-4">Volver al inicio</a>
  </section>
</BaseLayout>
