---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página no encontrada" noindex>
  <section class="mx-auto max-w-2xl px-6 py-32 text-center">
    <h1 class="font-display text-4xl font-bold">Página no encontrada</h1>
    <p class="mt-4 text-ink-soft">La página que buscas no existe o se ha movido.</p>
    <a href="/" class="mt-8 inline-block underline underline-offset-4">Volver al inicio</a>
  </section>
</BaseLayout>
